{
  "name": "@arro/app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:styles": "uniwind generate-artifacts --css ./global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "npm run generate:styles && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "expo install --check && npm run typecheck",
    "build:web": "expo export --platform web",
    "vercel-build": "npm run build:web",
    "serve": "expo serve"
  },
  "dependencies": {
    "@google/react-native-make-payment": "^0.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/checkout-sheet-kit": "^3.9.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "~57.0.20",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-server": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@arro/contracts": "file:../../packages/contracts",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
