# Web development can omit this and use http://localhost:3000.
# Native devices must use a URL reachable from the device. Production should use HTTPS.
EXPO_PUBLIC_ARRO_API_URL=https://api.example.com
# Optional server-only origin for SSR/loaders. It is never bundled into the
# browser or native app; local development can bypass a public tunnel here.
# ARRO_INTERNAL_API_URL=http://127.0.0.1:3000
# Required for production web canonical URLs, robots.txt, sitemap.xml, and JSON-LD.
# Use the public HTTPS origin only: no path, query, fragment, or credentials.
EXPO_PUBLIC_ARRO_SITE_URL=https://app.example.com
EXPO_PUBLIC_ARRO_CURRENCY=USD
# Baked into both the Android PaymentsClient and the JavaScript action guard.
# Native builds intentionally accept live payment actions only.
GOOGLE_PAY_ENVIRONMENT=PRODUCTION
