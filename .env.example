NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Browser/mobile-web origins allowed to call public APIs. Use public HTTPS origins;
# exact loopback HTTP origins are also supported for local browser development.
# APP_ALLOWED_ORIGINS=https://app.example.com,http://localhost:8081
# ARRO_FRONTEND_SERVER_TOKEN=shared-server-only-token-at-least-32-characters
# ARRO_FRONTEND_SERVER_TOKEN_FILE=/run/secrets/frontend-server-token
# Optional explicit UCP profile authority. When omitted, Arro derives
# PUBLIC_BASE_URL/.well-known/ucp. If set, it must match that URL.
# PLATFORM_PROFILE_URL=https://api.arro.example/.well-known/ucp

# Dedicated UCP HTTP-message-signing identity. Production accepts exactly one
# protected EC P-256 private JWK source: an inline deployment secret or a file
# mounted by the deployment secret manager. Never put the private `d` member in
# logs, source control, public profiles, or any EXPO_PUBLIC_* value.
# UCP_PLATFORM_SIGNING_PRIVATE_JWK_JSON={"kty":"EC",...}
# UCP_PLATFORM_SIGNING_PRIVATE_JWK_FILE=/run/secrets/ucp-platform-signing-private.jwk
# During two-phase rotation, this contains prepublished/retired public-only keys.
# UCP_PLATFORM_ADDITIONAL_PUBLIC_JWKS_JSON=[]

# Production launch verification. These stores are isolated from production
# because launch software verification writes reference transactions and consume-once
# payment credentials. The public API must already be running at PUBLIC_BASE_URL.
# VERIFICATION_DATABASE_URL=postgresql://arro:arro_verify_password@localhost:5434/arro_verify
# VERIFICATION_REDIS_URL=redis://localhost:6381
# VERIFICATION_PRIMARY_AUTONOMOUS_ROUTE=trusted_host
# VERIFICATION_PAYMENT_CREDENTIAL_ENCRYPTION_KEY=base64-or-hex-32-byte-verification-key
LOG_LEVEL=info
DEPENDENCY_CHECK_TIMEOUT_MS=1500
# Local service URLs for docker compose or equivalent developer infrastructure.
# Production must use managed service credentials from the deployment secret store.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgresql://arro:arro_dev_password@localhost:5433/arro
REDIS_URL=redis://localhost:6380
# Production deployments may supply protected single-line files instead of
# inline secret values. The deployment platform owns those files and rotation.
# DATABASE_URL_FILE=/run/secrets/database-url
# API_KEY_PEPPER_FILE=/run/secrets/api-key-pepper
# AGENT_SESSION_SIGNING_SECRET_FILE=/run/secrets/agent-session-signing-secret
# Host sources used only by `compose.production.yml`; the override mounts each
# one at its corresponding `/run/secrets/*` runtime path.
# POSTGRES_PASSWORD_HOST_FILE=.runtime/secrets/postgres-password
# API_DATABASE_URL_HOST_FILE=.runtime/secrets/api-database-url
# API_KEY_PEPPER_HOST_FILE=.runtime/secrets/api-key-pepper
# AGENT_SESSION_SIGNING_SECRET_HOST_FILE=.runtime/secrets/agent-session-signing-secret
# ARRO_FRONTEND_SERVER_TOKEN_HOST_FILE=.runtime/secrets/frontend-server-token
# UCP_PLATFORM_SIGNING_PRIVATE_JWK_HOST_FILE=.runtime/secrets/ucp-platform-signing-private.jwk
# Optional Docker API container overrides. Leave unset for Compose-managed
# `postgres`/`redis` service DNS; set only when the API container must reach
# externally managed services.
# API_DATABASE_URL=postgresql://arro:arro_dev_password@postgres:5432/arro
# API_REDIS_URL=redis://redis:6379
API_KEY_PEPPER=local-development-api-key-pepper-change-for-shared-environments
AGENT_SESSION_SIGNING_SECRET=local-development-agent-session-signing-secret-change-for-shared-environments
AGENT_SESSION_MAX_TTL_SECONDS=1800

# Payment runtime. Merchant-hosted checkout works without these. Tokenized direct
# UCP completion requires PAYMENTS_ENABLED, Redis, a 32-byte encryption key, and
# exact runtime tokenizer credentials for each merchant/handler/endpoint.
PAYMENTS_ENABLED=false
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY=base64-or-hex-32-byte-key
# PAYMENT_ACTION_SIGNING_SECRET=minimum-32-character-hosted-action-secret
# Strict production activation accepts only merchant-authoritative Order evidence.
# Each enabled/advertised direct-payment route must point to its own evidence file.
# REQUIRE_LIVE_PAYMENT_ACTIVATION=true
# TRUSTED_HOST_ACTIVATION_EVIDENCE_FILE=docs/payment-activation/trusted-host-production.json
# AP2_ACTIVATION_EVIDENCE_FILE=docs/payment-activation/ap2-production.json
# GOOGLE_PAY_NATIVE_ACTIVATION_EVIDENCE_FILE=docs/payment-activation/google-pay-native-production.json
# GOOGLE_PAY_WEB_ACTIVATION_EVIDENCE_FILE=docs/payment-activation/google-pay-web-production.json
# PROCESSOR_TOKENIZER_ACTIVATION_EVIDENCE_FILE=docs/payment-activation/processor-tokenizer-production.json
PAYMENT_CREDENTIAL_TTL_SECONDS=900
# Optional trusted host payment-capability metadata. Host envelopes must still
# bind exact merchant, checkout, handler, amount, currency, expiry, and nonce.
# HOST_PAYMENT_CAPABILITIES_JSON=[]
# HOST_PAYMENT_ATTESTATION_KEYS_JSON=[]
AUTONOMOUS_PURCHASES_ENABLED=false
# Required when AUTONOMOUS_PURCHASES_ENABLED=true. trusted_host is the complete
# executable route.
# PRIMARY_AUTONOMOUS_ROUTE=trusted_host
# Enable only with PAYMENTS_ENABLED=true and exact production handler/auth JSON.
PROCESSOR_TOKENIZER_ENABLED=false
# Register each executable handler implementation. A Stripe-native Processor
# Tokenizer must declare a live session endpoint and a /tokenize endpoint. The
# merchant session creates a manual-capture PaymentIntent for the exact Checkout;
# /tokenize verifies that Intent and returns the checkout-scoped UCP instrument.
# UCP_PAYMENT_HANDLER_SPECS_JSON=[{"adapterKind":"processor_tokenizer","handlerName":"com.merchant.stripe","platformHandlerId":"arro_stripe_payment_sheet","versions":["2026-08-25"],"specification":"https://merchant.example/ucp/payment-handlers/com.merchant.stripe","schema":"https://merchant.example/ucp/payment-handlers/com.merchant.stripe/schema.json","environment":"PRODUCTION","availableInstruments":[{"type":"card"}],"handlerConfig":{"gateway":"stripe","credential_type":"stripe_payment_intent","merchant_info":{"account_reference":"merchant-owned-stripe-account"},"endpoints":{"native_session":"https://merchant.example/ucp/payment-handlers/com.merchant.stripe/native-session","tokenize":"https://merchant.example/ucp/payment-handlers/com.merchant.stripe/tokenize"}}}]
# Private endpoint credentials stay separate from public handler metadata. Omit
# tokenizeEndpoint so the same exact merchant/handler credential can authorize
# both the declared native-session and /tokenize endpoints.
# UCP_TOKENIZER_AUTH_JSON={"https://merchant.example":{"provider":"com.merchant.stripe","environment":"PRODUCTION","bearerToken":"merchant-runtime-secret"}}
# Optional origin-scoped auth for merchant UCP checkout/order endpoints.
# UCP_MERCHANT_AUTH_JSON={"https://merchant.example":{"type":"bearer","token":"merchant-ucp-secret"}}
# Optional Shopify token-tier authentication. Tokens are acquired at runtime
# and refreshed before their 60-minute expiry; never paste a short-lived token.
# SHOPIFY_AGENT_CLIENT_ID=
# SHOPIFY_AGENT_CLIENT_SECRET=
GOOGLE_PAY_ENABLED=false
# Enables first-party Android native com.google.pay execution. It does not enable
# or require an Arro-hosted browser action. Release builds and the API accept
# production actions only.
GOOGLE_PAY_ENVIRONMENT=PRODUCTION
# Production native activation is fail-closed until these values match the one
# exact com.google.pay handler declaration, merchant, PAYMENT_GATEWAY PSP, and
# provider approval. The native evidence file must bind the same values to a
# merchant-authoritative Order produced by an Android native payment.
# GOOGLE_PAY_PRODUCTION_MERCHANT_ID=
# GOOGLE_PAY_PRODUCTION_HANDLER_ID=arro_google_pay_client
# GOOGLE_PAY_PRODUCTION_PSP=
# GOOGLE_PAY_PRODUCTION_APPROVAL_REFERENCE=
# Optional Arro-hosted Google Pay Web fallback. This remains off even when
# GOOGLE_PAY_ENABLED=true unless explicitly enabled here. Web activation alone
# requires the exact signed-action origin list and an independently verified
# merchant Order bound to that origin.
GOOGLE_PAY_WEB_ENABLED=false
# GOOGLE_PAY_WEB_ALLOWED_ORIGINS=https://api.arro.example
# GOOGLE_PAY_WEB_PRODUCTION_REGISTERED_ORIGIN=https://api.arro.example
AP2_RUNTIME_ENABLED=false
# Enables exact AP2 open/closed Checkout and Payment mandates, trusted issuer and
# key-binding verification, UCP placement, replay protection, and receipts.
# Runtime validation also requires payments, Postgres, and trusted issuer keys.
# AP2_TRUSTED_ISSUERS_JSON=[]
# Enables the official UCP Embedded Checkout session and JSON-RPC lifecycle.
# Runtime validation requires Postgres and PAYMENT_ACTION_SIGNING_SECRET; each
# host must separately allow the protocol, origin, presentation, and embedding.
EMBEDDED_CHECKOUT_RUNTIME_ENABLED=false
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
CONNECTOR_TIMEOUT_MS=10000
CATALOG_HTTP_MAX_CONNECTIONS_PER_ORIGIN=64
CATALOG_CONNECTOR_MAX_SOURCES_PER_REQUEST=5
CATALOG_CONNECTOR_MAX_CONCURRENCY_PER_REQUEST=3
CATALOG_CONNECTOR_COALESCING_WINDOW_MS=100
# Product detail is re-read on every server render, on back navigation and by
# every shopper looking at the same product. Reuse is bounded so a live price
# never goes visibly stale, and a reused answer keeps the fetch time it had.
CATALOG_PRODUCT_DETAIL_CACHE_TTL_MS=60000
# Advisory search results stay current for five minutes, then refresh in the
# background while Redis keeps the source-declared projection alive.
CATALOG_SEARCH_CACHE_TTL_MS=300000
CONNECTOR_DNS_CACHE_ENABLED=true
CONNECTOR_DNS_CACHE_TTL_MS=30000
CONNECTOR_DNS_CACHE_MAX_ENTRIES=512
TARGET_BUSINESS_MATRIX_CACHE_TTL_MS=5000
SHUTDOWN_GRACE_PERIOD_MS=25000
STARTUP_MIGRATION_VALIDATION=false
REQUEST_AUDIT_LOG_RETENTION_DAYS=90
SEARCH_AUDIT_LOG_RETENTION_DAYS=30
PURCHASE_SESSION_RETENTION_DAYS=30
DISCOVERY_OBSERVATION_RETENTION_DAYS=180
CONFORMANCE_MAX_AGE_DAYS=30
CONFORMANCE_FIXTURE_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAILURE_MODE=open
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UCP_DISCOVERY_MAX=10
RATE_LIMIT_AGENT_SESSION_MAX=20

# Arro ships with Shopify Global Catalog broad discovery as the built-in baseline
# catalog source. Set CATALOG_ADAPTERS_JSON only to replace that registry with an
# explicit source set; use [] only when catalog access is intentionally disabled.
# Production requires PUBLIC_BASE_URL (and therefore PLATFORM_PROFILE_URL) to be a
# public HTTPS identity for UCP/MCP requests. Descriptors are validated at startup,
# including any referenced secret environment variables.
#
# Recognised descriptor fields: kind, mode, adapterId, businessId, displayName,
# domain, shopDomain, endpointUrl, profileUrl, profileHash, platformProfileUrl,
# sourceType, maxProducts, headers, authTokenEnv, authHeaderName, authScheme,
# storefrontAccessTokenEnv. Unknown fields are rejected.
#
# kind=shopify_global_catalog_mcp, mode=broad_discovery - multi-merchant discovery (the default source):
# CATALOG_ADAPTERS_JSON=[{"kind":"shopify_global_catalog_mcp","mode":"broad_discovery","adapterId":"shopify-global-catalog","businessId":"shopify-global-catalog"}]
# kind=shopify_global_catalog_mcp - one connected merchant; domain drives the seller-authority guard:
# CATALOG_ADAPTERS_JSON=[{"kind":"shopify_global_catalog_mcp","adapterId":"merchant-shopify-global-mcp","businessId":"merchant-connected","displayName":"Merchant","domain":"merchant.example.com"}]
# kind=shopify_storefront_mcp - one merchant's own Storefront Catalog MCP:
# CATALOG_ADAPTERS_JSON=[{"kind":"shopify_storefront_mcp","adapterId":"merchant-shopify-mcp","businessId":"merchant-connected","displayName":"Merchant","shopDomain":"merchant.myshopify.com"}]
# kind=ucp_mcp - generic UCP MCP merchant. Requests carry the platform profile URL derived from PUBLIC_BASE_URL:
# CATALOG_ADAPTERS_JSON=[{"kind":"ucp_mcp","adapterId":"merchant-ucp-mcp","businessId":"merchant-connected","displayName":"Merchant","domain":"merchant.example.com","endpointUrl":"https://merchant.example.com/api/ucp/mcp","profileUrl":"https://merchant.example.com/.well-known/ucp","authTokenEnv":"MERCHANT_UCP_MCP_TOKEN"}]
# MERCHANT_UCP_MCP_TOKEN=
# kind=ucp_rest - POST search endpoint speaking Arro's adapter envelope:
# CATALOG_ADAPTERS_JSON=[{"kind":"ucp_rest","adapterId":"merchant-ucp-rest","businessId":"merchant-connected","displayName":"Merchant","domain":"merchant.example.com","endpointUrl":"https://merchant.example.com/ucp/catalog/search","authTokenEnv":"MERCHANT_UCP_CATALOG_TOKEN"}]
# MERCHANT_UCP_CATALOG_TOKEN=
# kind=ucp_rest, mode=ucp_products_get - GET product-list endpoints such as UCPReady/WooCommerce:
# CATALOG_ADAPTERS_JSON=[{"kind":"ucp_rest","mode":"ucp_products_get","adapterId":"merchant-ucp-products","businessId":"merchant-connected","displayName":"Merchant","domain":"merchant.example.com","endpointUrl":"https://merchant.example.com/wp-json/ucpready/v1/products","profileUrl":"https://merchant.example.com/.well-known/ucp"}]
# kind=shopify_storefront_graphql - non-UCP fallback. Prefer Shopify UCP MCP when available:
# CATALOG_ADAPTERS_JSON=[{"kind":"shopify_storefront_graphql","adapterId":"merchant-shopify-graphql","businessId":"merchant-connected","displayName":"Merchant","shopDomain":"merchant.myshopify.com","storefrontAccessTokenEnv":"MERCHANT_SHOPIFY_STOREFRONT_TOKEN"}]
# MERCHANT_SHOPIFY_STOREFRONT_TOKEN=

# Pipe-delimited query set for live production-search verification during verify:launch.
PRODUCTION_SEARCH_VERIFY_QUERIES=iphone mobile|samsung mobile|running shoes|black jacket|fridge

# Expo app. EXPO_PUBLIC_* values are public bundle configuration; never put secrets here.
# EXPO_PUBLIC_ARRO_API_URL=https://api.atishghimire.com.np
# EXPO_PUBLIC_ARRO_CURRENCY=USD
